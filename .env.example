# Google service account with read-only (Viewer) access to the content Sheet.
GOOGLE_SERVICE_ACCOUNT_EMAIL=site-reader@your-project.iam.gserviceaccount.com
# Paste the private_key from the service-account JSON. Escaped \n sequences
# and wrapping quotes are handled.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# The ID from the Sheet URL: docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEET_ID=

# Shared secret for POST /api/revalidate (header x-revalidate-secret).
# Generate with: openssl rand -hex 32
REVALIDATE_SECRET=
