# Google service account with read-only (Viewer) access to the content Sheet.
GOOGLE_SERVICE_ACCOUNT_EMAIL=site-reader@your-project.iam.gserviceaccount.com
# Paste the private_key from the service-account JSON. Escaped \n sequences
# and wrapping quotes are handled.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# The ID from the Sheet URL: docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEET_ID=

# Shared secret for POST /api/revalidate (header x-revalidate-secret).
# Generate with: openssl rand -hex 32
REVALIDATE_SECRET=

# Canonical origin for canonical links, JSON-LD and sitemaps.
NEXT_PUBLIC_SITE_URL=https://frenchvineyard.com
# Plausible site domain (loads only after the visitor accepts).
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=frenchvineyard.com

# Affiliate IDs used by /go/[provider]/[id]/ (lib/affiliates.ts). A missing ID
# still redirects, untagged, and logs an error.
GYG_PARTNER_ID=
VIATOR_PID=
# Booking.com: BOOKING_AID for the direct programme, or the three
# TRAVELPAYOUTS_* values to wrap links through Travelpayouts.
BOOKING_AID=
TRAVELPAYOUTS_MARKER=
TRAVELPAYOUTS_TRS=
TRAVELPAYOUTS_BOOKING_PROGRAM=
EXPEDIA_CAMREF=
WINALIST_REF=

# Click log: the Apps Script web app URL and its CLICKS_SECRET (docs/apps-script.js).
# Leave blank to turn click logging off.
CLICKS_WEBHOOK_URL=
CLICKS_WEBHOOK_SECRET=

# Local only: render from a JSON fixture instead of the live Sheet
# (npm run build:fixture uses fixtures/sheet.json).
# SHEET_FIXTURE=fixtures/sheet.json

# Content pipeline (pipeline/README.md). A separate service account with
# Editor access to the Sheet; the site's account above stays read-only.
ANTHROPIC_API_KEY=
PIPELINE_SERVICE_ACCOUNT_EMAIL=pipeline-writer@your-project.iam.gserviceaccount.com
PIPELINE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Defaults to GOOGLE_SHEET_ID.
PIPELINE_SHEET_ID=
# PIPELINE_MODEL=claude-sonnet-5-5
# PIPELINE_CHECK_MODEL=claude-haiku-5-5
# PIPELINE_BUDGET_USD=5
# PIPELINE_EUR_USD_RATE=1.08
# PIPELINE_PASS_SCORE=80
