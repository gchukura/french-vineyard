# Google service account with read-only (Viewer) access to the content Sheet.
GOOGLE_SERVICE_ACCOUNT_EMAIL=site-reader@your-project.iam.gserviceaccount.com
# Paste the private_key from the service-account JSON. Escaped \n sequences
# and wrapping quotes are handled.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# The ID from the Sheet URL: docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEET_ID=

# Shared secret for POST /api/revalidate (header x-revalidate-secret).
# Generate with: openssl rand -hex 32
REVALIDATE_SECRET=

# Canonical origin for canonical links, JSON-LD and sitemaps.
NEXT_PUBLIC_SITE_URL=https://frenchvineyard.com
# Keeps search engines out until launch: on unless set to 0 (docs/DOMAIN.md).
SITE_NOINDEX=1
# Plausible site domain (loads only after the visitor accepts).
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=frenchvineyard.com

# Affiliate IDs used by /go/[provider]/[id]/ (lib/affiliates.ts). A missing ID
# still redirects, untagged, and logs an error.
GYG_PARTNER_ID=
VIATOR_PID=
# Booking.com: BOOKING_AID for the direct programme, or the three
# TRAVELPAYOUTS_* values to wrap links through Travelpayouts.
BOOKING_AID=
TRAVELPAYOUTS_MARKER=
TRAVELPAYOUTS_TRS=
TRAVELPAYOUTS_BOOKING_PROGRAM=
EXPEDIA_CAMREF=
WINALIST_REF=
# Stay22 Allez affiliate id. When set, hotel Booking.com and Expedia links go
# through Stay22 instead of BOOKING_AID / Travelpayouts / EXPEDIA_CAMREF.
STAY22_AID=

# Click log: the Apps Script web app URL and its CLICKS_SECRET (docs/apps-script.js).
# Leave blank to turn click logging off.
CLICKS_WEBHOOK_URL=
CLICKS_WEBHOOK_SECRET=

# Local only: render from a JSON fixture instead of the live Sheet
# (npm run build:fixture uses fixtures/sheet.json).
# SHEET_FIXTURE=fixtures/sheet.json

# Content pipeline (pipeline/README.md). A separate service account with
# Editor access to the Sheet; the site's account above stays read-only.
ANTHROPIC_API_KEY=
PIPELINE_SERVICE_ACCOUNT_EMAIL=pipeline-writer@your-project.iam.gserviceaccount.com
PIPELINE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Defaults to GOOGLE_SHEET_ID.
PIPELINE_SHEET_ID=
# Where the pipeline POSTs /api/revalidate/. Until the domain is live, the
# production vercel.app URL (set as the SITE_URL repo variable).
# SITE_URL=https://french-vineyard.vercel.app
# PIPELINE_MODEL=claude-sonnet-5-5
# PIPELINE_CHECK_MODEL=claude-haiku-5-5
# PIPELINE_BUDGET_USD=25
# PIPELINE_EUR_USD_RATE=1.08
# PIPELINE_PASS_SCORE=80

# Hero images (npm run pipeline -- images; pipeline/README.md).
# Contact address for the Wikimedia User-Agent (required).
IMAGES_CONTACT_EMAIL=
# Vercel Blob credentials for uploads (not needed for --dry-run): either a
# read-write token, or the OIDC pair that `vercel env pull` provides when the
# store is connected to the Development environment.
BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=
# VERCEL_OIDC_TOKEN=
# Optional second and third photo sources.
PIXABAY_API_KEY=
PEXELS_API_KEY=
# PIPELINE_IMAGE_MODEL=claude-sonnet-5-5
# IMAGES_MIN_SCORE=70

# Tours (npm run pipeline -- tours:check; pipeline/README.md). Optional: with a
# GetYourGuide Partner API key, tours:check refreshes GetYourGuide tours' price,
# rating and review count from the API instead of following their links.
GYG_API_KEY=
# tours:import fills Viator links in from Viator's Partner API (v2) with this key.
VIATOR_API_KEY=
# 1 lets tours:import read the schema.org data on the Winalist estate page of a
# pasted experience (Winalist publishes no API documentation). Off by default.
# WINALIST_READ_PAGES=1
